_:p107 sh:path m:missingCount .
_:p107 sh:minCount "1"^^xsd:integer .
_:p107 sh:maxCount "1"^^xsd:integer .
_:p107 sh:datatype xsd:integer .
_:p107 sh:minInclusive "0"^^xsd:integer .
m:CollectionRunShape sh:sparql _:q108 .
_:q108 sh:message "P-COVERAGE: 기대=수신+누락" .
_:q108 sh:select "PREFIX m: <https://example.org/marketing/> SELECT $this WHERE { $this m:expectedCount ?e ; m:receivedCount ?r ; m:missingCount ?n . FILTER(?e != ?r + ?n) }" .
