_:p118 sh:nodeKind sh:IRI .
m:AnalysisResultShape sh:sparql _:q119 .
_:q119 sh:message "answered는 입력 근거가 필요하다" .
_:q119 sh:select "PREFIX m: <https://example.org/marketing/> SELECT $this WHERE { $this m:resultStatus \"answered\" . FILTER NOT EXISTS { $this m:input ?i } }" .
