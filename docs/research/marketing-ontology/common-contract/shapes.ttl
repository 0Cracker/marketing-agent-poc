m:ObservationShape sh:sparql _:q66 .
_:q66 sh:message "P-VALUE: present에만 value가 정확히 하나 있다" .
_:q66 sh:select "PREFIX m: <https://example.org/marketing/> SELECT $this WHERE { { $this m:availability \"present\" . FILTER NOT EXISTS { $this m:value ?v } } UNION { $this m:availability ?s ; m:value ?v . FILTER(?s != \"present\") } }" .
m:ObservationShape sh:sparql _:q67 .
_:q67 sh:message "P-VALUE: 비present에는 reason이 필요하다" .
_:q67 sh:select "PREFIX m: <https://example.org/marketing/> SELECT $this WHERE { $this m:availability ?s . FILTER(?s != \"present\") FILTER NOT EXISTS { $this m:reason ?r } }" .
