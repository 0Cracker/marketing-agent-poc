@prefix m: <https://example.org/marketing/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

m: rdf:type owl:Ontology .
m: owl:versionInfo "MC-1.0.0" .
m:Entity rdf:type owl:Class .
m:Entity rdfs:subClassOf prov:Entity .
m:Entity skos:prefLabel "Entity" .
m:Entity skos:definition "식별 가능한 정보·대상 개체" .
m:Subject rdf:type owl:Class .
m:Subject rdfs:subClassOf m:Entity .
m:Subject skos:prefLabel "Subject" .
m:Subject skos:definition "관측·원문·사건이 다루는 대상" .
m:Brand rdf:type owl:Class .
m:Brand rdfs:subClassOf m:Subject .
m:Brand skos:prefLabel "Brand" .
m:Brand skos:definition "원천 ID로 확인된 브랜드" .
m:Product rdf:type owl:Class .
m:Product rdfs:subClassOf m:Subject .
m:Product skos:prefLabel "Product" .
m:Product skos:definition "원천에서 식별한 제품 및 규격" .
m:Campaign rdf:type owl:Class .
m:Campaign rdfs:subClassOf m:Subject .
m:Campaign skos:prefLabel "Campaign" .
m:Campaign skos:definition "계정 범위의 광고 캠페인과 유효 설정" .
m:Seller rdf:type owl:Class .
m:Seller rdfs:subClassOf m:Subject .
m:Seller skos:prefLabel "Seller" .
m:Seller skos:definition "가격 관측의 판매처" .
m:Location rdf:type owl:Class .
m:Location rdfs:subClassOf m:Subject .
m:Location skos:prefLabel "Location" .
m:Location skos:definition "자사 재고 관측 위치" .
m:MarketScope rdf:type owl:Class .
m:MarketScope rdfs:subClassOf m:Subject .
m:MarketScope skos:prefLabel "MarketScope" .
m:MarketScope skos:definition "국가·카테고리·수집범위·비교집합·유효기간" .
m:MetricDefinition rdf:type owl:Class .
m:MetricDefinition rdfs:subClassOf m:Entity .
m:MetricDefinition skos:prefLabel "MetricDefinition" .
m:MetricDefinition skos:definition "지표의 의미·단위·자료형·집계·버전" .
m:Observation rdf:type owl:Class .
m:Observation rdfs:subClassOf m:Entity .
m:Observation skos:prefLabel "Observation" .
m:Observation skos:definition "대상 하나와 지표 하나의 값 또는 확보 상태" .
m:SourceArtifact rdf:type owl:Class .
m:SourceArtifact rdfs:subClassOf m:Entity .
m:SourceArtifact skos:prefLabel "SourceArtifact" .
m:SourceArtifact skos:definition "원천 파일의 경로·내용 hash" .
m:SourceRecord rdf:type owl:Class .
m:SourceRecord rdfs:subClassOf m:Entity .
m:SourceRecord skos:prefLabel "SourceRecord" .
m:SourceRecord skos:definition "원천 파일에 있는 식별 가능한 행과 버전" .
m:CollectionRun rdf:type owl:Class .
m:CollectionRun rdfs:subClassOf prov:Activity .
m:CollectionRun skos:prefLabel "CollectionRun" .
m:CollectionRun skos:definition "수집 구간·기대·수신·누락을 보존하는 실행" .
m:Transformation rdf:type owl:Class .
m:Transformation rdfs:subClassOf prov:Activity .
m:Transformation skos:prefLabel "Transformation" .
m:Transformation skos:definition "매핑 버전과 코드 버전이 있는 변환 활동" .
m:TimeInterval rdf:type owl:Class .
m:TimeInterval rdfs:subClassOf m:Entity .
m:TimeInterval skos:prefLabel "TimeInterval" .
m:TimeInterval skos:definition "시작 포함·종료 제외의 현지 달력 구간" .
m:TimeInstant rdf:type owl:Class .
m:TimeInstant rdfs:subClassOf m:Entity .
m:TimeInstant skos:prefLabel "TimeInstant" .
m:TimeInstant skos:definition "시간대와 원천 offset이 있는 시점" .
m:Review rdf:type owl:Class .
m:Review rdfs:subClassOf m:Entity .
m:Review skos:prefLabel "Review" .
m:Review skos:definition "대상에 대한 원천 원문과 별점" .
m:EvidenceSpan rdf:type owl:Class .
m:EvidenceSpan rdfs:subClassOf m:Entity .
m:EvidenceSpan skos:prefLabel "EvidenceSpan" .
m:EvidenceSpan skos:definition "원문 문자열의 실제 발췌와 반개방 offset" .
m:Event rdf:type owl:Class .
m:Event rdfs:subClassOf m:Entity .
m:Event skos:prefLabel "Event" .
m:Event skos:definition "원천이 기록한 사건 및 시점·구간" .
m:Claim rdf:type owl:Class .
m:Claim rdfs:subClassOf m:Entity .
m:Claim skos:prefLabel "Claim" .
m:Claim skos:definition "원천이 주장하는 명제" .
m:Hypothesis rdf:type owl:Class .
m:Hypothesis rdfs:subClassOf m:Entity .
m:Hypothesis skos:prefLabel "Hypothesis" .
m:Hypothesis skos:definition "지지·반대·대안 근거를 가진 설명 후보" .
m:AnalysisResult rdf:type owl:Class .
m:AnalysisResult rdfs:subClassOf m:Entity .
m:AnalysisResult skos:prefLabel "AnalysisResult" .
m:AnalysisResult skos:definition "입력·기준일·질문·상태를 가진 분석 결과" .
m:Observation owl:disjointWith m:Product .
m:Observation owl:disjointWith m:Campaign .
m:Claim owl:disjointWith m:Observation .
m:Hypothesis owl:disjointWith m:Observation .
m:Hypothesis owl:disjointWith m:AnalysisResult .
m:brand rdf:type owl:ObjectProperty .
m:brand rdfs:range m:Brand .
m:promotes rdf:type owl:ObjectProperty .
m:promotes rdfs:range m:Product .
m:subject rdf:type owl:ObjectProperty .
m:subject rdfs:range m:Subject .
m:scope rdf:type owl:ObjectProperty .
m:scope rdfs:range m:MarketScope .
m:member rdf:type owl:ObjectProperty .
m:member rdfs:range m:Product .
m:metric rdf:type owl:ObjectProperty .
m:metric rdfs:range m:MetricDefinition .
m:interval rdf:type owl:ObjectProperty .
m:interval rdfs:range m:TimeInterval .
m:instant rdf:type owl:ObjectProperty .
m:instant rdfs:range m:TimeInstant .
m:validInterval rdf:type owl:ObjectProperty .
m:validInterval rdfs:range m:TimeInterval .
m:sourceRecord rdf:type owl:ObjectProperty .
m:sourceRecord rdfs:range m:SourceRecord .
m:artifact rdf:type owl:ObjectProperty .
m:artifact rdfs:range m:SourceArtifact .
m:generatedBy rdf:type owl:ObjectProperty .
m:generatedBy rdfs:range m:Transformation .
m:seller rdf:type owl:ObjectProperty .
m:seller rdfs:range m:Seller .
m:location rdf:type owl:ObjectProperty .
m:location rdfs:range m:Location .
m:evidenceSpan rdf:type owl:ObjectProperty .
m:evidenceSpan rdfs:range m:EvidenceSpan .
m:originalReview rdf:type owl:ObjectProperty .
m:originalReview rdfs:range m:Review .
m:supports rdf:type owl:ObjectProperty .
m:supports rdfs:range m:Hypothesis .
m:counters rdf:type owl:ObjectProperty .
m:counters rdfs:range m:Hypothesis .
m:input rdf:type owl:ObjectProperty .
m:supersedes rdf:type owl:ObjectProperty .
m:supersedes rdfs:range m:SourceRecord .
m:brand rdfs:domain m:Product .
m:promotes rdfs:domain m:Campaign .
m:member rdfs:domain m:MarketScope .
m:metric rdfs:domain m:Observation .
m:artifact rdfs:domain m:SourceRecord .
m:originalReview rdfs:domain m:EvidenceSpan .
m:input rdfs:domain m:AnalysisResult .
m:supersedes rdfs:domain m:SourceRecord .
m:input rdfs:range rdfs:Resource .
m:sourceRecord rdfs:subPropertyOf prov:wasDerivedFrom .
m:generatedBy rdfs:subPropertyOf prov:wasGeneratedBy .
