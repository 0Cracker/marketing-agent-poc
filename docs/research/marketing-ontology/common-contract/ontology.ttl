@prefix m: <https://example.org/marketing/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

m: rdf:type owl:Ontology .
m: owl:versionInfo "MC-1.0.0-logic-2" .
# Explicit declarations for the PROV-O terms reused by this definition graph.
# This is a local declaration subset, not an import of the complete PROV-O.
prov:Entity a owl:Class ; rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .
prov:Activity a owl:Class ; rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .
prov:wasGeneratedBy a owl:ObjectProperty ; rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .
prov:wasDerivedFrom a owl:ObjectProperty ; rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .
m:Entity rdf:type owl:Class .
m:Entity rdfs:subClassOf prov:Entity .
m:Entity skos:prefLabel "Entity" .
m:Entity skos:definition "식별 가능한 정보·대상 개체" .
m:Subject rdf:type owl:Class .
m:Subject rdfs:subClassOf m:Entity .
m:Subject skos:prefLabel "Subject" .
m:Subject skos:definition "관측·원문·사건이 다루는 대상" .
m:Brand rdf:type owl:Class .
m:Brand rdfs:subClassOf m:Subject .
m:Brand skos:prefLabel "Brand" .
m:Brand skos:definition "원천 ID로 확인된 브랜드" .
m:Product rdf:type owl:Class .
m:Product rdfs:subClassOf m:Subject .
m:Product skos:prefLabel "Product" .
m:Product skos:definition "원천에서 식별한 제품 및 규격" .
m:Variant rdf:type owl:Class .
m:Variant rdfs:subClassOf m:Subject .
m:Variant skos:prefLabel "Variant" .
m:Variant skos:definition "원천의 별도 식별자로 확인된 판매 변형; 용량만으로 생성하지 않음" .
m:Category rdf:type owl:Class .
m:Category rdfs:subClassOf m:Entity .
m:Category skos:prefLabel "Category" .
m:Category skos:definition "원천의 별도 분류 식별자로 확인된 제품 범주" .
m:Campaign rdf:type owl:Class .
m:Campaign rdfs:subClassOf m:Subject .
m:Campaign skos:prefLabel "Campaign" .
m:Campaign skos:definition "계정 범위의 광고 캠페인과 유효 설정" .
m:Seller rdf:type owl:Class .
m:Seller rdfs:subClassOf m:Subject .
m:Seller skos:prefLabel "Seller" .
m:Seller skos:definition "가격 관측의 판매처" .
m:Location rdf:type owl:Class .
m:Location rdfs:subClassOf m:Subject .
m:Location skos:prefLabel "Location" .
m:Location skos:definition "자사 재고 관측 위치" .
m:MarketScope rdf:type owl:Class .
m:MarketScope rdfs:subClassOf m:Subject .
m:MarketScope skos:prefLabel "MarketScope" .
m:MarketScope skos:definition "국가·카테고리·수집범위·비교집합·유효기간" .
m:MetricDefinition rdf:type owl:Class .
m:MetricDefinition rdfs:subClassOf m:Entity .
m:MetricDefinition skos:prefLabel "MetricDefinition" .
m:MetricDefinition skos:definition "지표의 의미·단위·자료형·집계·버전" .
m:Observation rdf:type owl:Class .
m:Observation rdfs:subClassOf m:Entity .
m:Observation skos:prefLabel "Observation" .
m:Observation skos:definition "대상 하나와 지표 하나의 값 또는 확보 상태" .
m:SourceArtifact rdf:type owl:Class .
m:SourceArtifact rdfs:subClassOf m:Entity .
m:SourceArtifact skos:prefLabel "SourceArtifact" .
m:SourceArtifact skos:definition "원천 파일의 경로·내용 hash" .
m:SourceRecord rdf:type owl:Class .
m:SourceRecord rdfs:subClassOf m:Entity .
m:SourceRecord skos:prefLabel "SourceRecord" .
m:SourceRecord skos:definition "원천 파일에 있는 식별 가능한 행과 버전" .
m:CollectionRun rdf:type owl:Class .
m:CollectionRun rdfs:subClassOf prov:Activity .
m:CollectionRun skos:prefLabel "CollectionRun" .
m:CollectionRun skos:definition "수집 구간·기대·수신·누락을 보존하는 실행" .
m:Transformation rdf:type owl:Class .
m:Transformation rdfs:subClassOf prov:Activity .
m:Transformation skos:prefLabel "Transformation" .
m:Transformation skos:definition "매핑 버전과 코드 버전이 있는 변환 활동" .
m:TimeInterval rdf:type owl:Class .
m:TimeInterval rdfs:subClassOf m:Entity .
m:TimeInterval skos:prefLabel "TimeInterval" .
m:TimeInterval skos:definition "시작 포함·종료 제외의 현지 달력 구간" .
m:TimeInstant rdf:type owl:Class .
m:TimeInstant rdfs:subClassOf m:Entity .
m:TimeInstant skos:prefLabel "TimeInstant" .
m:TimeInstant skos:definition "시간대와 원천 offset이 있는 시점" .
m:Review rdf:type owl:Class .
m:Review rdfs:subClassOf m:Entity .
m:Review skos:prefLabel "Review" .
m:Review skos:definition "대상에 대한 원천 원문과 별점" .
m:EvidenceSpan rdf:type owl:Class .
m:EvidenceSpan rdfs:subClassOf m:Entity .
m:EvidenceSpan skos:prefLabel "EvidenceSpan" .
m:EvidenceSpan skos:definition "원문 문자열의 실제 발췌와 반개방 offset" .
m:Event rdf:type owl:Class .
m:Event rdfs:subClassOf m:Entity .
m:Event skos:prefLabel "Event" .
m:Event skos:definition "원천이 기록한 사건 및 시점·구간" .
m:Promotion rdf:type owl:Class .
m:Promotion rdfs:subClassOf m:Event .
m:Promotion skos:prefLabel "Promotion" .
m:Promotion skos:definition "원천 행사 식별자로 확인된 프로모션 사건; 행사 방식은 별도 속성" .
m:Claim rdf:type owl:Class .
m:Claim rdfs:subClassOf m:Entity .
m:Claim skos:prefLabel "Claim" .
m:Claim skos:definition "원천이 주장하는 명제" .
m:Hypothesis rdf:type owl:Class .
m:Hypothesis rdfs:subClassOf m:Entity .
m:Hypothesis skos:prefLabel "Hypothesis" .
m:Hypothesis skos:definition "지지·반대·대안 근거를 가진 설명 후보" .
m:AnalysisResult rdf:type owl:Class .
m:AnalysisResult rdfs:subClassOf m:Entity .
m:AnalysisResult skos:prefLabel "AnalysisResult" .
m:AnalysisResult skos:definition "입력·기준일·질문·상태를 가진 분석 결과" .
m:Observation owl:disjointWith m:Product .
m:Observation owl:disjointWith m:Campaign .
m:Claim owl:disjointWith m:Observation .
m:Hypothesis owl:disjointWith m:Observation .
m:Hypothesis owl:disjointWith m:AnalysisResult .
m:brand rdf:type owl:ObjectProperty .
m:variantOf rdf:type owl:ObjectProperty .
m:variantOf rdfs:domain m:Variant .
m:variantOf rdfs:range m:Product .
m:inCategory rdf:type owl:ObjectProperty .
m:inCategory rdfs:domain m:Product .
m:inCategory rdfs:range m:Category .
m:brand rdfs:range m:Brand .
m:promotes rdf:type owl:ObjectProperty .
m:promotes rdfs:range m:Product .
m:subject rdf:type owl:ObjectProperty .
m:subject rdfs:range m:Subject .
m:scope rdf:type owl:ObjectProperty .
m:scope rdfs:range m:MarketScope .
m:member rdf:type owl:ObjectProperty .
m:member rdfs:range m:Product .
m:metric rdf:type owl:ObjectProperty .
m:metric rdfs:range m:MetricDefinition .
m:interval rdf:type owl:ObjectProperty .
m:interval rdfs:range m:TimeInterval .
m:instant rdf:type owl:ObjectProperty .
m:instant rdfs:range m:TimeInstant .
m:validInterval rdf:type owl:ObjectProperty .
m:validInterval rdfs:range m:TimeInterval .
m:sourceRecord rdf:type owl:ObjectProperty .
m:sourceRecord rdfs:range m:SourceRecord .
m:artifact rdf:type owl:ObjectProperty .
m:artifact rdfs:range m:SourceArtifact .
m:generatedBy rdf:type owl:ObjectProperty .
m:generatedBy rdfs:range m:Transformation .
m:seller rdf:type owl:ObjectProperty .
m:seller rdfs:range m:Seller .
m:location rdf:type owl:ObjectProperty .
m:location rdfs:range m:Location .
m:evidenceSpan rdf:type owl:ObjectProperty .
m:evidenceSpan rdfs:range m:EvidenceSpan .
m:originalReview rdf:type owl:ObjectProperty .
m:originalReview rdfs:range m:Review .
m:supports rdf:type owl:ObjectProperty .
m:supports rdfs:range m:Hypothesis .
m:counters rdf:type owl:ObjectProperty .
m:counters rdfs:range m:Hypothesis .
m:input rdf:type owl:ObjectProperty .
m:supersedes rdf:type owl:ObjectProperty .
m:supersedes rdfs:range m:SourceRecord .
m:brand rdfs:domain m:Product .
m:promotes rdfs:domain m:Campaign .
m:member rdfs:domain m:MarketScope .
m:metric rdfs:domain m:Observation .
m:artifact rdfs:domain m:SourceRecord .
m:originalReview rdfs:domain m:EvidenceSpan .
m:input rdfs:domain m:AnalysisResult .
m:supersedes rdfs:domain m:SourceRecord .
m:input rdfs:range rdfs:Resource .
m:sourceRecord rdfs:subPropertyOf prov:wasDerivedFrom .
m:generatedBy rdfs:subPropertyOf prov:wasGeneratedBy .
m:sourceId rdf:type owl:DatatypeProperty .
m:sourceId rdfs:range xsd:string .
m:identifierNamespace rdf:type owl:DatatypeProperty .
m:identifierNamespace rdfs:range xsd:string .
m:label rdf:type owl:DatatypeProperty .
m:label rdfs:range xsd:string .
m:category rdf:type owl:DatatypeProperty .
m:category rdfs:range xsd:string .
m:coverageText rdf:type owl:DatatypeProperty .
m:coverageText rdfs:range xsd:string .
m:calendar rdf:type owl:DatatypeProperty .
m:calendar rdfs:range xsd:string .
m:grain rdf:type owl:DatatypeProperty .
m:grain rdfs:range xsd:string .
m:timezone rdf:type owl:DatatypeProperty .
m:timezone rdfs:range xsd:string .
m:recordId rdf:type owl:DatatypeProperty .
m:recordId rdfs:range xsd:string .
m:sourceLine rdf:type owl:DatatypeProperty .
m:sourceLine rdfs:domain m:SourceRecord .
m:sourceLine rdfs:range xsd:integer .
m:fieldPath rdf:type owl:DatatypeProperty .
m:fieldPath rdfs:range xsd:string .
m:sourceContext rdf:type owl:DatatypeProperty .
m:sourceContext rdfs:domain m:SourceRecord .
m:sourceContext rdfs:range xsd:string .
m:sourceContext skos:definition "질문 실행 중 원천의 비관측 필드를 보존하는 JSON 문자열. null과 필드 부재를 구분하며 수치 관측은 별도 Observation에서 재조회한다. 영구 저장하지 않는다." .
m:path rdf:type owl:DatatypeProperty .
m:path rdfs:range xsd:string .
m:sha256 rdf:type owl:DatatypeProperty .
m:sha256 rdfs:range xsd:string .
m:mappingVersion rdf:type owl:DatatypeProperty .
m:mappingVersion rdfs:range xsd:string .
m:codeVersion rdf:type owl:DatatypeProperty .
m:codeVersion rdfs:range xsd:string .
m:metricId rdf:type owl:DatatypeProperty .
m:metricId rdfs:range xsd:string .
m:definition rdf:type owl:DatatypeProperty .
m:definition rdfs:range xsd:string .
m:unit rdf:type owl:DatatypeProperty .
m:unit rdfs:range xsd:string .
m:aggregation rdf:type owl:DatatypeProperty .
m:aggregation rdfs:range xsd:string .
m:availability rdf:type owl:DatatypeProperty .
m:availability rdfs:range xsd:string .
m:originKind rdf:type owl:DatatypeProperty .
m:originKind rdfs:range xsd:string .
m:reason rdf:type owl:DatatypeProperty .
m:reason rdfs:range xsd:string .
m:questionId rdf:type owl:DatatypeProperty .
m:questionId rdfs:range xsd:string .
m:resultStatus rdf:type owl:DatatypeProperty .
m:resultStatus rdfs:range xsd:string .
m:channel rdf:type owl:DatatypeProperty .
m:channel rdfs:range xsd:string .
m:platform rdf:type owl:DatatypeProperty .
m:platform rdfs:range xsd:string .
m:conversionName rdf:type owl:DatatypeProperty .
m:conversionName rdfs:range xsd:string .
m:attributionModel rdf:type owl:DatatypeProperty .
m:attributionModel rdfs:range xsd:string .
m:language rdf:type owl:DatatypeProperty .
m:language rdfs:range xsd:string .
m:bodyText rdf:type owl:DatatypeProperty .
m:bodyText rdfs:range xsd:string .
m:quote rdf:type owl:DatatypeProperty .
m:quote rdfs:range xsd:string .
m:sellerStatus rdf:type owl:DatatypeProperty .
m:sellerStatus rdfs:range xsd:string .
m:brandRole rdf:type owl:DatatypeProperty .
m:brandRole rdfs:range xsd:string .
m:comparisonGroup rdf:type owl:DatatypeProperty .
m:comparisonGroup rdfs:range xsd:string .
m:eventKind rdf:type owl:DatatypeProperty .
m:eventKind rdfs:range xsd:string .
m:promotionType rdf:type owl:DatatypeProperty .
m:promotionType rdfs:domain m:Promotion .
m:promotionType rdfs:range xsd:string .
m:claimText rdf:type owl:DatatypeProperty .
m:claimText rdfs:range xsd:string .
m:changeField rdf:type owl:DatatypeProperty .
m:changeField rdfs:range xsd:string .
m:policyVersion rdf:type owl:DatatypeProperty .
m:policyVersion rdfs:range xsd:string .
m:definitionVersion rdf:type owl:DatatypeProperty .
m:definitionVersion rdfs:range xsd:string .
m:seriesRole rdf:type owl:DatatypeProperty .
m:seriesRole rdfs:range xsd:string .
m:value rdf:type owl:DatatypeProperty .
m:value rdfs:range xsd:decimal .
m:volumeMl rdf:type owl:DatatypeProperty .
m:volumeMl rdfs:range xsd:decimal .
m:discountRatio rdf:type owl:DatatypeProperty .
m:discountRatio rdfs:range xsd:decimal .
m:beforeValue rdf:type owl:DatatypeProperty .
m:beforeValue rdfs:range xsd:decimal .
m:afterValue rdf:type owl:DatatypeProperty .
m:afterValue rdfs:range xsd:decimal .
m:ratingScaleMax rdf:type owl:DatatypeProperty .
m:ratingScaleMax rdfs:range xsd:decimal .
m:revision rdf:type owl:DatatypeProperty .
m:revision rdfs:range xsd:integer .
m:offsetStart rdf:type owl:DatatypeProperty .
m:offsetStart rdfs:range xsd:integer .
m:offsetEnd rdf:type owl:DatatypeProperty .
m:offsetEnd rdfs:range xsd:integer .
m:expectedCount rdf:type owl:DatatypeProperty .
m:expectedCount rdfs:range xsd:integer .
m:receivedCount rdf:type owl:DatatypeProperty .
m:receivedCount rdfs:range xsd:integer .
m:missingCount rdf:type owl:DatatypeProperty .
m:missingCount rdfs:range xsd:integer .
m:attributionWindowDays rdf:type owl:DatatypeProperty .
m:attributionWindowDays rdfs:range xsd:integer .
m:startDate rdf:type owl:DatatypeProperty .
# xsd:date is outside the OWL 2 datatype map. Exact date typing and ordering
# remain mandatory in TimeIntervalShape; do not ignore unsupported datatypes.
m:startDate rdfs:range rdfs:Literal .
m:endDateExclusive rdf:type owl:DatatypeProperty .
m:endDateExclusive rdfs:range rdfs:Literal .
m:timestamp rdf:type owl:DatatypeProperty .
m:timestamp rdfs:range xsd:dateTime .
m:startAt rdf:type owl:DatatypeProperty .
m:startAt rdfs:range xsd:dateTime .
m:endAtExclusive rdf:type owl:DatatypeProperty .
m:endAtExclusive rdfs:range xsd:dateTime .
m:availableAt rdf:type owl:DatatypeProperty .
m:availableAt rdfs:range xsd:dateTime .
m:asOf rdf:type owl:DatatypeProperty .
m:asOf rdfs:range xsd:dateTime .
m:isSynthetic rdf:type owl:DatatypeProperty .
m:isSynthetic rdfs:range xsd:boolean .
m:taxIncluded rdf:type owl:DatatypeProperty .
m:taxIncluded rdfs:range xsd:boolean .
m:shippingIncluded rdf:type owl:DatatypeProperty .
m:shippingIncluded rdfs:range xsd:boolean .
m:verifiedPurchase rdf:type owl:DatatypeProperty .
m:verifiedPurchase rdfs:range xsd:boolean .
