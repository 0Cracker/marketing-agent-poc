export type Filters={source?:string;channel:string;campaignId:string;device:string};
export type Period={id:'baseline'|'current';start:string;end:string};
export type Measures={impressions:number;clicks:number;spend:number;sessions:number;view:number;cart:number;checkout:number;purchases:number;returnPurchases:number;orders:number;units:number;listRevenue:number;discount:number;revenue:number;ledgerOrders:number;ledgerRevenue:number;paymentAttempts:number;paymentFailures:number;redirectErrors:number;loadTotalMs:number;loadSamples:number;trackingExpected:number;trackingReceived:number;duplicateEvents:number};
export type Fact=Measures&{exposureBasis:string;id:string;date:string;periodId:string;campaignId:string;device:string};
export type Breakdown=Fact&{dimension:string;key:string;label:string;source:string;creativeId:string;audienceId:string;placement:string;keyword:string;matchType:string;browser:string;paymentMethod:string};
export type DetailRecord={id:string;date:string;category:string;campaignId:string|null;device:string;productId:string|null;title:string;values:Record<string,string|number|boolean>};
export type Campaign={id:string;label:string;channel:string;source:string;platform:string;adType:string;exposureBasis:string;dailyBudget:number;targetRoas:number;bidStrategy:string;landingUrl:string;advertisedProductId:string};
export type TrainingData={contract:string;caseId:string;label:string;asOf:string;periods:Period[];campaigns:Campaign[];products:{id:string;label:string;listPrice:number;discountRate:number}[];facts:Fact[];breakdowns:Breakdown[];reach:{periodId:string;campaignId:string;device:string;impressions:number;reach:number|null}[];records:DetailRecord[]};
export type Total=Measures&{rates:Record<'roas'|'ctr'|'cpm'|'cpc'|'cvr'|'cpa'|'aov'|'sessionCvr'|'checkoutRate'|'paymentFailureRate'|'loadMs'|'adCtr'|'contentClickRate'|'adCpm'|'contentCpm',number|null>};
export const trainingCaseIds:string[];
export const trainingViews:[string,string][];
export function campaignDisplayName(data:TrainingData,id:string):string;
export function displayTrainingText(value:unknown):string;
export function trainingMediaOptions(data:TrainingData):{key:string;channel:string;source:string}[];
export function changeTrainingMedia(data:TrainingData,filters:Filters,key:string):Filters;
export function summarize(rows:Partial<Measures>[]):Total;
export function selectFacts(data:TrainingData,filters:Filters):Fact[];
export function selectBreakdowns(data:TrainingData,filters:Filters,dimension:string):Breakdown[];
export function selectRecords(data:TrainingData,filters:Filters):DetailRecord[];
export function comparePeriods(data:TrainingData,filters:Filters):{period:Period;total:Total;rows:Fact[]}[];
export function trendRows(data:TrainingData,filters:Filters):{date:string;roas:number|null}[];
export function metricValue(total:Total,key:string):number|null;
export function metricMissingReason(rows:Fact[],key:string):{label:string;reason:string};
export function metricPeriodSeries(data:TrainingData,filters:Filters,key:string):{day:number;baseline:number|null;current:number|null;baselineDate:string;currentDate:string}[];
