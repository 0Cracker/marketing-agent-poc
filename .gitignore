# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; publish only the iteration-log skill.
/.sites-runtime/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/poc-iteration-log/
/.codex/
/outputs/
/work/

# Python validation caches are local build artifacts.
__pycache__/
*.py[cod]

# Local evaluation execution stores; the JSON run/evidence records are versioned.
/evidence/v0.4.0/live-questions-*/flow.sqlite*
