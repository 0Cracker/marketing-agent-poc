{
  "name": "marketing-agent-poc",
  "version": "0.4.24",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "build:agent-trace": "vite build --config vite.agent-trace.config.ts",
    "start": "vite preview --host 127.0.0.1 --port 5173",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/roas/*.test.mjs tests/roas/*.test.ts",
    "test:agents": "node --experimental-strip-types --test tests/roas/agent.test.mjs tests/agents/providers/*.test.mjs tests/agents/tools/*.test.mjs tests/agents/engine/*.test.mjs tests/agents/run-api/*.test.mjs tests/agents/ui/*.test.mjs tests/agents/integration/*.test.mjs",
    "test:roas": "npm test",
    "test:training": "node --test tests/roas/separation.test.mjs",
    "data:training": "node scripts/roas/generate-training-dashboard.mjs",
    "prestart:agents": "npm run build:agent-trace",
    "start:agents": "node scripts/roas/agent-server.mjs",
    "test:legacy": "node --experimental-strip-types legacy/tests/marketing.test.ts && node --experimental-strip-types legacy/tests/demo.test.ts",
    "start:legacy-agents": "node legacy/scripts/agent-server.mjs",
    "dev:legacy": "vite --config vite.legacy.config.ts --host 127.0.0.1 --port 5174",
    "db:generate:legacy": "drizzle-kit generate --config legacy/drizzle.config.ts",
    "predev:agent": "npm run build:agent-trace",
    "dev:agent": "node scripts/roas/dev-agent.mjs",
    "predev:agent:mock": "npm run build:agent-trace",
    "dev:agent:mock": "node scripts/roas/dev-agent.mjs --mock"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
